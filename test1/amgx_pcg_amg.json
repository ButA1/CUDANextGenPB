{
    "config_version": 2,
    "solver": {
        "solver": "PCG",
        "preconditioner": {
            "solver": "AMG",
            "algorithm": "AGGREGATION",
            "selector": "SIZE_2",
            "cycle": "V",
            "max_iters": 1,
            "presweeps": 1,
            "postsweeps": 1,
            "coarsest_sweeps": 2,
            "max_levels": 24,
            "smoother": {
                "solver": "MULTICOLOR_DILU",
                "relaxation_factor": 0.9
            },
            "coarse_solver": "DENSE_LU_SOLVER"
        },
        "max_iters": 1000,
        "tolerance": 1e-10,
        "norm": "L2",
        "convergence": "RELATIVE_INI_CORE",
        "monitor_residual": 1,
        "print_solve_stats": 1,
        "obtain_timings": 1
    }
}
