[input]
filetype = pqr
filename = 1VSZ.pqr
[../]

[mesh]
mesh_shape = 0
perfil1 = 0.95
perfil2 = 0.2
scale   = 2.0
[../]

[model]
bc_type = 1
molecular_dielectric_constant = 2      # Dielectric constant inside the molecule
solvent_dielectric_constant   = 80     # Dielectric constant of the solvent (e.g., water)
ionic_strength                = 0.145  # Ionic strength (mol/L)
T                             = 298.15 # Temperature in Kelvin
calc_energy    = 2
calc_coulombic = 1
[../]

[algorithm]
amgx_config = amgx_pcgf_amg_block_jacobi.json
energy_method = 1
fmm_mac = 0.3
fmm_multipole_order = 9
fmm_leaf_size = 16
fmm_target_leaf_size = 1024
linear_solver = amgx
bh_leaf_size  = 256
[../]
